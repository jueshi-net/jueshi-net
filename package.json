{
  "name": "kuajing-baoxian",
  "version": "1.36.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-build-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "bash scripts/deploy.sh",
    "postinstall": "prisma generate",
    "crawler:daemon": "npx tsx scripts/advanced-crawler/daemon.ts",
    "crawler:test": "npx tsx scripts/advanced-crawler/daemon-test.ts",
    "verify:runtime-db": "node scripts/verify-runtime-db-env.mjs",
    "test:unit": "vitest run tests/phase-g-analytics-funnels.test.ts",
    "test:regression": "vitest run tests/phase-g-analytics-funnels.test.ts && npx tsx tests/v18.3.3-task-chain-e2e.ts",
    "test:beta:local": "echo \"Beta local tests: role/membership helpers, reward config, task context merge\" && npx tsx scripts/test-beta-local.ts 2>/dev/null || echo \"No beta-local script yet\"",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:prod": "BASE_URL=https://jueshi.net playwright test --reporter=list",
    "jueshi-audit:p0": "cd tools/jueshi-audit && npm run audit:staging -- --suite p0-public-pages,p0-redirects",
    "jueshi-audit:p1": "cd tools/jueshi-audit && AUDIT_BASE_URL=https://i.jueshi.net tsx src/audit-stabilized.ts",
    "jueshi-audit:full": "cd tools/jueshi-audit && AUDIT_BASE_URL=https://i.jueshi.net tsx src/audit-stabilized.ts",
    "jueshi-audit:webkit": "cd tools/jueshi-audit && AUDIT_BASE_URL=https://i.jueshi.net tsx src/audit-stabilized.ts",
    "test:vps": "echo \"Run on VPS: cd /home/deploy/xixiong-saas && npx tsx tests/v18.3.2-db-tests.ts\"",
    "test:beta:gate": "npm run lint && npm run build && npm run test:unit",
    "verify:predeploy": "npm run build && git diff --check && npx prisma migrate status"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@next/third-parties": "^16.2.6",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@stripe/stripe-js": "^9.6.0",
    "@types/pg": "^8.20.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "pinyin-match": "^1.2.10",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "whois": "^2.16.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
