{
  "name": "jueshi-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only audit tool for jueshi.net / xixiong-saas — P0 public page and redirect verification via Playwright",
  "scripts": {
    "audit": "tsx src/index.ts",
    "audit:p0": "tsx src/index.ts --suite p0-public-pages,p0-redirects",
    "audit:public": "tsx src/index.ts --suite p0-public-pages",
    "audit:redirects": "tsx src/index.ts --suite p0-redirects",
    "audit:staging": "tsx src/index.ts --base-url https://i.jueshi.net",
    "audit:prod": "tsx src/index.ts --base-url https://jueshi.net",
    "audit:stabilized": "tsx src/audit-stabilized.ts",
    "audit:company": "tsx src/audit-stabilized.ts --suite company",
    "audit:documents": "tsx src/audit-stabilized.ts --suite documents",
    "audit:membership": "tsx src/audit-stabilized.ts --suite membership",
    "audit:company-switch": "tsx src/audit-stabilized.ts --suite company-switch",
    "audit:documents-company-switch": "tsx src/audit-stabilized.ts --suite documents-company-switch",
    "audit:word-export": "tsx src/audit-word-export.ts",
    "audit:full": "tsx src/audit-stabilized.ts --suite all && tsx src/audit-word-export.ts",
    "audit:document-runtime": "tsx src/audit-document-runtime.ts",
    "audit:webkit": "AUDIT_BASE_URL=https://i.jueshi.net tsx src/audit-stabilized.ts --engine webkit",
    "audit:stabilized:staging": "AUDIT_BASE_URL=https://i.jueshi.net tsx src/audit-stabilized.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
